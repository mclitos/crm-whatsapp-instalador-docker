# ─── Instalador del CRM de WhatsApp (.env.example) ──────────────────────────
# Copiá este archivo a `.env` y completá tus valores:
#   cp .env.example .env
# `.env` está ignorado por Git y nunca se publica; este ejemplo solo trae
# valores ficticios. Las credenciales de Supabase/Meta NO van acá: viven en
# `credenciales.env` (ver `credenciales.env.example`).

# ─── Red y binding (Docker) ─────────────────────────────────────────────────
# IP local a la que se publican los puertos 3300 (instalador y CRM).
# Valor por defecto: 127.0.0.1 (solo esta máquina).
# Para abrir el instalador desde otro equipo de la red local, poné la IP
# exacta de la interfaz (por ejemplo 192.168.1.50). No uses 0.0.0.0.
HOST_BIND_ADDRESS=127.0.0.1

# Host público que forman la URL del instalador y del CRM
# (http://<PUBLIC_HOST>:3300). Por defecto: localhost.
# En red local tiene que coincidir con HOST_BIND_ADDRESS.
PUBLIC_HOST=localhost

# ─── Autenticación del instalador ───────────────────────────────────────────
# Token de configuración de un solo uso. Si se define, el instalador lo usa
# y no lo imprime; si se omite, genera uno al azar y lo muestra una vez.
# Requisito: al menos 32 caracteres, sin espacios.
WEB_INSTALLER_SETUP_TOKEN=cambia-este-token-de-al-menos-32-caracteres-000000

# ─── Origen del CRM ─────────────────────────────────────────────────────────
# Repo del que se clona el CRM. Por defecto es el fork mantenido; para usar
# tu propia copia (por ejemplo con tu marca), poné tu fork acá.
# También se puede definir en `credenciales.env`; esta variable tiene prioridad.
CRM_REPO_URL=https://github.com/mclitos/wacrm.git

# ─── Flujo clásico / avanzado (variables de entorno del shell) ─────────────
# Ruta alternativa al archivo de credenciales. Tiene prioridad sobre
# `credenciales.ruta` y `./credenciales.env`. Útil si guardás las
# credenciales fuera del proyecto (ver `npm run vincular`).
#CRM_CREDENCIALES=/ruta/fuera-del-proyecto/mis-credenciales.env

# Puerto que usa `npm run tunel` para abrir la URL pública temporal.
# Si se omite, detecta solo: 3300 con el CRM de Docker, 3000 con Node local.
#PORT=3300

# Versión de la Graph API de Meta. Solo si necesitás forzar otra versión;
# por defecto el instalador usa la verificada (v26.0).
#GRAPH_API_VERSION=v26.0
